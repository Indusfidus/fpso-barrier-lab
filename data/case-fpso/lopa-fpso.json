{
  "caseId": "fpso-generic",
  "note": "Each scenario has an 'as found' design and a recommended fix. 'Naive' multiplies every claimed layer. 'Strict' applies independence and validity checks. All PFDs are generic CCPS-style values or PFDavg from the coursework data. ASSUMED values are marked.",
  "scenarios": [
    {
      "id": "F1",
      "system": "SEP",
      "title": "HP separator gas blowby to LP separator",
      "cause": "HP separator level control loop fails (LT-1 or LCV fails open). Liquid level is lost and gas flows into the LP separator.",
      "consequence": "LP separator (design 10 barg) overpressured by HP gas. Rupture, fire and explosion in the separation module.",
      "severity": "Catastrophic",
      "cases": [
        {
          "id": "A",
          "label": "As found",
          "initiatingEvent": {
            "description": "BPCS level loop failure",
            "frequency": 0.1,
            "sensor": "LT-1",
            "basis": "CCPS generic BPCS loop failure"
          },
          "layers": [
            {
              "id": "ALM",
              "name": "Low level alarm LAL + operator closes inlet",
              "kind": "human",
              "pfd": 0.1,
              "credited": true,
              "sensor": "LT-1",
              "responseTimeMin": 15,
              "note": "Alarm comes from the same transmitter as the control loop."
            },
            {
              "id": "SIF",
              "name": "LSLL SIF closes liquid outlet SDV (SIL 1)",
              "kind": "sif",
              "pfd": 0.015,
              "credited": true,
              "sensor": "LT-2"
            },
            {
              "id": "PSV",
              "name": "LP separator PSV",
              "kind": "relief",
              "pfd": 0.01,
              "credited": true,
              "sensor": null,
              "sizedForScenario": false,
              "note": "Sized for fire case only, not full gas blowby. A common real finding."
            }
          ]
        },
        {
          "id": "B",
          "label": "Fix",
          "initiatingEvent": {
            "description": "BPCS level loop failure",
            "frequency": 0.1,
            "sensor": "LT-1",
            "basis": "CCPS generic BPCS loop failure"
          },
          "layers": [
            {
              "id": "ALM",
              "name": "Low level alarm from independent LT-3 + operator",
              "kind": "human",
              "pfd": 0.1,
              "credited": true,
              "sensor": "LT-3",
              "responseTimeMin": 15
            },
            {
              "id": "SIF",
              "name": "LSLL SIF upgraded to SIL 2",
              "kind": "sif",
              "pfd": 0.005,
              "credited": true,
              "sensor": "LT-2"
            },
            {
              "id": "PSV",
              "name": "LP separator PSV resized for full gas blowby",
              "kind": "relief",
              "pfd": 0.01,
              "credited": true,
              "sensor": null,
              "sizedForScenario": true
            }
          ]
        }
      ],
      "lessons": [
        "The low level alarm comes from the same transmitter as the control loop that failed. It cannot protect against its own failure.",
        "A PSV sized only for fire cannot be credited for gas blowby. Blowby needs a much larger relief rate.",
        "The fix needs an independent transmitter, a SIL 2 trip and a resized PSV."
      ]
    },
    {
      "id": "F2",
      "system": "INJ",
      "title": "Reinjection compressor discharge blocked",
      "cause": "Injection riser ESD valve SDV-2701 closes spuriously while the compressor runs.",
      "consequence": "Discharge piping overpressured above 385 barg design. High-pressure gas release, jet fire and escalation.",
      "severity": "Catastrophic",
      "cases": [
        {
          "id": "A",
          "label": "As found",
          "initiatingEvent": {
            "description": "Spurious closure of SDV-2701",
