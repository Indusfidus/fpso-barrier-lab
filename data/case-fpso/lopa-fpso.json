            "sensor": null,
            "basis": "ASSUMED generic valve spurious closure"
          },
          "layers": [
            {
              "id": "ALM",
              "name": "High pressure alarm PAH + operator trips compressor",
              "kind": "human",
              "pfd": 0.1,
              "credited": true,
              "sensor": "PT-1",
              "responseTimeMin": 1,
              "note": "Pressure rises to relief set point in about a minute. Too fast for an operator."
            },
            {
              "id": "SIF",
              "name": "PSHH SIF trips compressor (SIL 2)",
              "kind": "sif",
              "pfd": 0.005,
              "credited": true,
              "sensor": "PT-2"
            },
            {
              "id": "PSV",
              "name": "Discharge PSV",
              "kind": "relief",
              "pfd": 0.01,
              "credited": true,
              "sensor": null,
              "sizedForScenario": true
            }
          ]
        },
        {
          "id": "B",
          "label": "Fix",
          "initiatingEvent": {
            "description": "Spurious closure of SDV-2701",
            "frequency": 0.1,
            "sensor": null,
            "basis": "ASSUMED generic valve spurious closure"
          },
          "layers": [
            {
              "id": "ALM",
              "name": "PAH kept as an operator aid, not credited",
              "kind": "human",
              "pfd": 0.1,
              "credited": false,
              "sensor": "PT-1",
              "responseTimeMin": 1
            },
            {
              "id": "SIF",
              "name": "SIL 3 high-integrity trip, 2oo3 transmitters",
              "kind": "sif",
              "pfd": 0.0005,
              "credited": true,
              "sensor": "PT-2/3/4"
            },
            {
              "id": "PSV",
              "name": "Discharge PSV",
              "kind": "relief",
              "pfd": 0.01,
              "credited": true,
              "sensor": null,
              "sizedForScenario": true
            }
          ]
        }
      ],
      "lessons": [
        "Discharge pressure reaches the relief set point in about a minute. An operator cannot respond in time, so the alarm earns no credit.",
        "Naive LOPA passes. Strict LOPA fails by 5×.",
        "The fix is a SIL 3 high-integrity trip with 2oo3 voting, plus the PSV. Keep the alarm as an aid."
      ]
    },
